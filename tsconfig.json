{
    "compilerOptions": {
        "target": "ES2021",
        "lib": ["ES2021", "dom"],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["cypress"]
    },
    "include": ["cypress/**/*.ts"]
}